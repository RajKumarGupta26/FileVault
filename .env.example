PORT=5000
NODE_ENV=development

# Get a free connection string from MongoDB Atlas (atlas.mongodb.com),
# or point this at a local MongoDB instance: mongodb://localhost:27017/filevault
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/filevault

# Any long random string — used to sign login tokens
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE=30d

# Free account at cloudinary.com — dashboard shows these three values
# (or copy the single "API Environment variable" they give you into
# CLOUDINARY_URL instead and skip the three below).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

MAX_FILE_SIZE=262144000

# Password-reset emails — simplest path is a Gmail account with an App
# Password (Google Account → Security → 2-Step Verification → App passwords,
# needs 2FA turned on first). Not your normal Gmail password.
EMAIL_USER=youraccount@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM=FileVault <youraccount@gmail.com>
# For any other provider instead of Gmail, set these and EMAIL_USER/EMAIL_PASS above:
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
